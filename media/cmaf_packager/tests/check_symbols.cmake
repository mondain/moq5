if(APPLE)
    execute_process(COMMAND "${NM}" -m -gU "${LIBRARY}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
else()
    set(dynamic)
    if(SHARED)
        list(APPEND dynamic -D)
    endif()
    execute_process(COMMAND "${NM}" ${dynamic} -g --defined-only --format=posix
        "${LIBRARY}" RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
endif()
if(NOT rc EQUAL 0 OR NOT "${err}" STREQUAL "")
    message(FATAL_ERROR "nm failed: ${rc}: ${err}")
endif()
set(expected)
foreach(suffix cfg_init_sized create destroy init_segment timescale write)
    list(APPEND expected "moq_cmaf_packager_${suffix}")
endforeach()
set(actual)
string(REPLACE "\n" ";" lines "${symbols}")
foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES ":$")
        continue()
    endif()
    if(APPLE)
        # Mach-O archives retain private externals (including compiler support
        # data); these are not public exports. Select visibility, not a name
        # allowlist. A public unrelated symbol must still fail exact matching.
        if(line MATCHES "private external")
            continue()
        endif()
        if(NOT line MATCHES " external ([^ \t]+)$")
            message(FATAL_ERROR "unrecognized Mach-O nm output: ${line}")
        endif()
        set(name "${CMAKE_MATCH_1}")
        string(SUBSTRING "${name}" 0 1 prefix)
        if(prefix STREQUAL "_")
            string(SUBSTRING "${name}" 1 -1 name)
        endif()
    elseif(line MATCHES "^([^ \t]+)[ \t]+[A-Za-z][ \t]")
        set(name "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "unrecognized nm output: ${line}")
    endif()
    # Compare ALL defined public symbols, not only the packager prefix.
    list(APPEND actual "${name}")
endforeach()
list(REMOVE_DUPLICATES actual)
list(SORT actual)
list(SORT expected)
if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "packager export set mismatch\nexpected=${expected}\nactual=${actual}")
endif()
