cmake_minimum_required(VERSION 3.20)

if(APPLE)
    execute_process(COMMAND "${NM}" -m -gU "${LIBRARY}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
elseif(ELF AND NOT SHARED)
    # nm does not expose ELF visibility. Archives can contain hidden compiler
    # support globals, which are not part of the public API.
    execute_process(COMMAND "${READELF}" --wide --symbols "${LIBRARY}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
else()
    set(dynamic)
    if(SHARED)
        list(APPEND dynamic -D)
    endif()
    execute_process(COMMAND "${NM}" ${dynamic} -g --defined-only --format=posix
        "${LIBRARY}" RESULT_VARIABLE rc OUTPUT_VARIABLE symbols ERROR_VARIABLE err)
endif()
if(NOT rc EQUAL 0 OR NOT "${err}" STREQUAL "")
    message(FATAL_ERROR "symbol inspection failed: ${rc}: ${err}")
endif()
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/mpeg2ts.symbols" expected)
if(NOT expected)
    message(FATAL_ERROR "empty MPEG-TS symbol allowlist")
endif()
set(seen)
foreach(name IN LISTS expected)
    if(NOT name MATCHES "^moq_mpeg2ts_[a-z0-9_]+$" OR name IN_LIST seen)
        message(FATAL_ERROR "invalid or duplicate MPEG-TS symbol: ${name}")
    endif()
    list(APPEND seen "${name}")
endforeach()
set(actual)
string(REPLACE "\n" ";" lines "${symbols}")
foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES ":$")
        continue()
    endif()
    if(APPLE)
        # Mach-O archives retain private externals (including compiler support
        # data); these are not public exports. Select visibility, not a name
        # allowlist. A public unrelated symbol must still fail exact matching.
        if(line MATCHES "private external")
            continue()
        endif()
        if(NOT line MATCHES " external ([^ \t]+)$")
            message(FATAL_ERROR "unrecognized Mach-O nm output: ${line}")
        endif()
        set(name "${CMAKE_MATCH_1}")
        string(SUBSTRING "${name}" 0 1 prefix)
        if(prefix STREQUAL "_")
            string(SUBSTRING "${name}" 1 -1 name)
        endif()
    elseif(ELF AND NOT SHARED)
        if(line MATCHES "^(File:|Symbol table |Num:)")
            continue()
        endif()
        if(NOT line MATCHES "^[0-9]+:[ \t]+[0-9a-fA-F]+[ \t]+[0-9]+[ \t]+[^ \t]+[ \t]+([^ \t]+)[ \t]+([^ \t]+)[ \t]+([^ \t]+)([ \t]+(.*))?$")
            message(FATAL_ERROR "unrecognized ELF symbol output: ${line}")
        endif()
        set(binding "${CMAKE_MATCH_1}")
        set(visibility "${CMAKE_MATCH_2}")
        set(section "${CMAKE_MATCH_3}")
        set(name "${CMAKE_MATCH_5}")
        if(section STREQUAL "UND" OR NOT binding MATCHES "^(GLOBAL|WEAK|UNIQUE)$"
                OR NOT visibility MATCHES "^(DEFAULT|PROTECTED)$")
            continue()
        endif()
    elseif(line MATCHES "^([^ \t]+)[ \t]+[A-Za-z][ \t]")
        set(name "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "unrecognized nm output: ${line}")
    endif()
    # Compare ALL defined public symbols, not only the MPEG-TS prefix.
    list(APPEND actual "${name}")
endforeach()
list(REMOVE_DUPLICATES actual)
list(SORT actual)
list(SORT expected)
if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "MPEG-TS export set mismatch\nexpected=${expected}\nactual=${actual}")
endif()
