  */
 
 int picoquic_client_save_ticket_call_back(ptls_save_ticket_t* save_ticket_ctx,
-    ptls_t* tls, ptls_iovec_t input)
+    ptls_t* tls, ptls_iovec_t input, const ptls_save_ticket_properties_t* properties)
 {
