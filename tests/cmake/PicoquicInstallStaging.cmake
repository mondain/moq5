# Generate expectations from provider targets, independently of root install rules.
function(moq_picoquic_install_staging output)
    set(_required_targets picoquic-core)
    set(_forbidden_targets picoquic-log)
    if(MOQ_BUILD_ADAPTER_PICO_WT OR MOQ_BUILD_PICO_WT_MANAGED)
        list(APPEND _required_targets picoquic-log picohttp-core)
        set(_forbidden_targets "")
    elseif(TARGET picohttp-core)
        list(APPEND _forbidden_targets picohttp-core)
    endif()
    set(_required "")
    set(_forbidden "")
    set(_shared_count 0)
    set(_metadata "")
    foreach(_group required forbidden)
        foreach(_target IN LISTS _${_group}_targets)
            list(APPEND _${_group} "$<TARGET_FILE:${_target}>")
            get_target_property(_type ${_target} TYPE)
            if(_type STREQUAL "SHARED_LIBRARY" AND UNIX)
                list(APPEND _${_group} "$<TARGET_SONAME_FILE:${_target}>"
                    "$<TARGET_LINKER_FILE:${_target}>")
                if(_group STREQUAL "required")
                    math(EXPR _shared_count "${_shared_count} + 1")
                    string(APPEND _metadata
"set(shared_${_shared_count}_file [==[$<TARGET_FILE_NAME:${_target}>]==])
set(shared_${_shared_count}_soname [==[$<TARGET_SONAME_FILE_NAME:${_target}>]==])
set(shared_${_shared_count}_linker [==[$<TARGET_LINKER_FILE_NAME:${_target}>]==])
set(shared_${_shared_count}_rpath [==[$<TARGET_GENEX_EVAL:${_target},$<TARGET_PROPERTY:${_target},INSTALL_RPATH>>]==])
")
                endif()
            endif()
        endforeach()
    endforeach()
    set(_script "${CMAKE_CURRENT_BINARY_DIR}/picoquic-install-staging-$<CONFIG>.cmake")
    file(GENERATE OUTPUT "${_script}" CONTENT
"set(required [==[${_required}]==])
set(forbidden [==[${_forbidden}]==])
set(parent_build [==[${PROJECT_BINARY_DIR}]==])
set(install_libdir [==[${CMAKE_INSTALL_LIBDIR}]==])
set(shared_count ${_shared_count})
set(target_system [==[${CMAKE_SYSTEM_NAME}]==])
${_metadata}
include([==[${PROJECT_SOURCE_DIR}/tests/cmake/CheckPicoquicInstallStaging.cmake]==])
")
    set(${output} "${_script}" PARENT_SCOPE)
endfunction()
