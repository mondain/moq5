cmake_minimum_required(VERSION 3.20)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

function(check_rules apple compiler verbose defined value expected)
    set(APPLE "${apple}")
    foreach(lang C CXX)
        set(CMAKE_${lang}_COMPILER_ID "${compiler}")
        set(CMAKE_${lang}_VERBOSE_FLAG "${verbose}")
        unset(CMAKE_${lang}_VERBOSE_COMPILE_FLAG)
        if(defined)
            set(CMAKE_${lang}_VERBOSE_COMPILE_FLAG "${value}")
        endif()
    endforeach()
    include("${source}/cmake/MoqAppleAbiProbeRules.cmake")
    foreach(lang C CXX)
        if(NOT "${CMAKE_${lang}_VERBOSE_FLAG}" STREQUAL "${verbose}")
            message(FATAL_ERROR "Link verbosity changed for ${lang}")
        endif()
        if(expected STREQUAL "UNDEFINED")
            if(DEFINED CMAKE_${lang}_VERBOSE_COMPILE_FLAG)
                message(FATAL_ERROR "Unexpected compile override for ${compiler}")
            endif()
        elseif(NOT DEFINED CMAKE_${lang}_VERBOSE_COMPILE_FLAG
               OR NOT "${CMAKE_${lang}_VERBOSE_COMPILE_FLAG}" STREQUAL "${expected}")
            message(FATAL_ERROR "Compile verbosity changed incorrectly for ${lang}")
        endif()
    endforeach()
endfunction()

check_rules(TRUE AppleClang "-v -Wl,-v" FALSE "" "-v")
check_rules(TRUE Clang "-v -Wl,-v" FALSE "" "-v")
check_rules(FALSE Clang "-v -Wl,-v" FALSE "" UNDEFINED)
check_rules(TRUE GNU "-v -Wl,-v" FALSE "" UNDEFINED)
check_rules(TRUE AppleClang "-v" FALSE "" UNDEFINED)
check_rules(TRUE AppleClang "-v -Wl,-v" TRUE "" "")
check_rules(TRUE AppleClang "-v -Wl,-v" TRUE "-v" "-v")
check_rules(TRUE AppleClang "-v -Wl,-v" TRUE "caller-value" "caller-value")

set(CMAKE_USER_MAKE_RULES_OVERRIDE "generic-hook")
set(CMAKE_USER_MAKE_RULES_OVERRIDE_C "")
set(CMAKE_USER_MAKE_RULES_OVERRIDE_CXX "caller-cxx")
include("${source}/cmake/MoqAppleAbiProbe.cmake")
if(NOT CMAKE_USER_MAKE_RULES_OVERRIDE STREQUAL "generic-hook"
   OR NOT CMAKE_USER_MAKE_RULES_OVERRIDE_C STREQUAL ""
   OR NOT CMAKE_USER_MAKE_RULES_OVERRIDE_CXX STREQUAL "caller-cxx")
    message(FATAL_ERROR "Registrar replaced caller hooks")
endif()
unset(CMAKE_USER_MAKE_RULES_OVERRIDE_CXX)
include("${source}/cmake/MoqAppleAbiProbe.cmake")
if(NOT CMAKE_USER_MAKE_RULES_OVERRIDE_CXX STREQUAL "${source}/cmake/MoqAppleAbiProbeRules.cmake"
   OR DEFINED CACHE{CMAKE_USER_MAKE_RULES_OVERRIDE_CXX})
    message(FATAL_ERROR "Registrar must fill only undefined normal variables")
endif()

include("${source}/tests/cmake/ConsumerBuildContext.cmake")
# Exercise bracket delimiters, semicolons and literal variable references.
set(saved [==[/a path/]=]/${literal};toolchain.cmake]==])
_moq_context_quote("${saved}" quoted)
cmake_language(EVAL CODE "set(roundtrip ${quoted})")
if(NOT roundtrip STREQUAL saved)
    message(FATAL_ERROR "Context quoting changed the value")
endif()
set(CMAKE_TOOLCHAIN_FILE "")
unset(ENV{CMAKE_TOOLCHAIN_FILE})
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${source}/tests/cmake/apple-abi-probe/CallerRules.cmake")
moq_write_consumer_abi_context("${TEST_OUTPUT}/abi-context.cmake")
moq_write_consumer_context("${TEST_OUTPUT}/full-context.cmake")
set(context_vars CMAKE_TOOLCHAIN_FILE CMAKE_USER_MAKE_RULES_OVERRIDE
    CMAKE_USER_MAKE_RULES_OVERRIDE_C CMAKE_USER_MAKE_RULES_OVERRIDE_CXX)
foreach(kind abi full)
    unset(CMAKE_PROJECT_INCLUDE_BEFORE)
    unset(CMAKE_PROJECT_INCLUDE_BEFORE CACHE)
    foreach(var IN LISTS context_vars)
        unset(${var})
        unset(${var} CACHE)
    endforeach()
    include("${TEST_OUTPUT}/${kind}-context.cmake")
    foreach(var IN LISTS context_vars)
        if(NOT DEFINED CACHE{${var}})
            message(FATAL_ERROR "Preload did not persist ${var} in cache")
        endif()
        get_property(type CACHE ${var} PROPERTY TYPE)
        if(NOT type STREQUAL "STRING")
            message(FATAL_ERROR "Unexpected cache type for ${var}: ${type}")
        endif()
    endforeach()
    if(NOT CMAKE_TOOLCHAIN_FILE STREQUAL "")
        message(FATAL_ERROR "Toolchain serialization changed the value")
    endif()
    if(NOT CMAKE_USER_MAKE_RULES_OVERRIDE STREQUAL "${source}/tests/cmake/apple-abi-probe/CallerRules.cmake"
       OR NOT DEFINED CMAKE_USER_MAKE_RULES_OVERRIDE_C
       OR NOT CMAKE_USER_MAKE_RULES_OVERRIDE_C STREQUAL ""
       OR NOT CMAKE_USER_MAKE_RULES_OVERRIDE_CXX STREQUAL "${source}/cmake/MoqAppleAbiProbeRules.cmake")
        message(FATAL_ERROR "Preload did not preserve selected hooks")
    endif()
    foreach(binding normal cache)
        foreach(value "" "child-owned-value")
            foreach(var IN LISTS context_vars)
                unset(${var})
                unset(${var} CACHE)
                set(expected "${value}")
                if(var STREQUAL "CMAKE_TOOLCHAIN_FILE")
                    set(expected "")
                endif()
                if(binding STREQUAL "normal")
                    set(${var} "${expected}")
                else()
                    set(${var} "${expected}" CACHE STRING "Child-owned context")
                endif()
            endforeach()
            include("${TEST_OUTPUT}/${kind}-context.cmake")
            foreach(var IN LISTS context_vars)
                set(expected "${value}")
                if(var STREQUAL "CMAKE_TOOLCHAIN_FILE")
                    set(expected "")
                endif()
                if(NOT DEFINED ${var} OR NOT "${${var}}" STREQUAL "${expected}")
                    message(FATAL_ERROR "Preload replaced ${binding} ${var}")
                endif()
                if(binding STREQUAL "normal" AND DEFINED CACHE{${var}})
                    message(FATAL_ERROR "Preload cached caller-owned normal ${var}")
                endif()
                if(binding STREQUAL "cache" AND NOT "$CACHE{${var}}" STREQUAL "${expected}")
                    message(FATAL_ERROR "Preload replaced caller-owned cache ${var}")
                endif()
            endforeach()
        endforeach()
    endforeach()
endforeach()

foreach(var IN LISTS context_vars)
    unset(${var})
    unset(${var} CACHE)
endforeach()
set(CMAKE_USER_MAKE_RULES_OVERRIDE "")
set(CMAKE_USER_MAKE_RULES_OVERRIDE_CXX "")
include("${source}/cmake/MoqAppleAbiProbe.cmake")
if(NOT CMAKE_USER_MAKE_RULES_OVERRIDE STREQUAL ""
   OR NOT CMAKE_USER_MAKE_RULES_OVERRIDE_CXX STREQUAL "")
    message(FATAL_ERROR "Registrar replaced explicitly empty hooks")
endif()
