# Test-owned bundle validation, both before defaults and at project() entry.
function(_moq_check_consumer_bundle)
    set(expected @toolchain_quoted@)
    if(DEFINED CMAKE_TOOLCHAIN_FILE)
        set(selected "${CMAKE_TOOLCHAIN_FILE}")
    elseif(DEFINED ENV{CMAKE_TOOLCHAIN_FILE})
        set(selected "$ENV{CMAKE_TOOLCHAIN_FILE}")
    elseif(_moq_abi_loading_preload)
        set(selected "${expected}")
    else()
        set(selected "")
    endif()
    if(NOT selected STREQUAL "")
        if(NOT IS_ABSOLUTE "${selected}")
            if(EXISTS "${CMAKE_BINARY_DIR}/${selected}")
                set(selected "${CMAKE_BINARY_DIR}/${selected}")
            else()
                set(selected "${CMAKE_SOURCE_DIR}/${selected}")
            endif()
        endif()
        get_filename_component(selected "${selected}" REALPATH)
    endif()
    if(NOT selected STREQUAL expected)
        message(FATAL_ERROR "Consumer ABI bundle toolchain mismatch: expected '${expected}', selected '${selected}'")
    endif()
endfunction()
_moq_check_consumer_bundle()
