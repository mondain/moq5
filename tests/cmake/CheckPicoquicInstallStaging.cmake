if(NOT target_system STREQUAL "Darwin" AND NOT target_system STREQUAL "Linux")
    message(FATAL_ERROR "Provider staging fixture supports native Darwin/Linux only: ${target_system}")
endif()

# The versioned qualification lane must not silently become a static or
# unversioned control when a different provider checkout is selected.
if(require_static AND shared_count GREATER 0)
    message(FATAL_ERROR "Static provider required for this control lane")
endif()
if(require_versioned)
    if(shared_count EQUAL 0)
        message(FATAL_ERROR "Versioned shared provider required for this lane")
    endif()
    foreach(i RANGE 1 ${shared_count})
        if(shared_${i}_file STREQUAL shared_${i}_soname OR
           shared_${i}_soname STREQUAL shared_${i}_linker)
            message(FATAL_ERROR "Expected distinct full-version, loader and linker names")
        endif()
    endforeach()
endif()

if(phase STREQUAL "before")
    foreach(artifact IN LISTS required)
        if(NOT EXISTS "${artifact}")
            message(FATAL_ERROR "Required parent provider artifact missing: ${artifact}")
        endif()
        message(STATUS "Parent provider artifact present: ${artifact}")
    endforeach()
    foreach(artifact IN LISTS forbidden)
        if(EXISTS "${artifact}")
            message(STATUS "Unused raw parent provider artifact present: ${artifact}")
        else()
            message(STATUS "Unused raw parent provider artifact absent: ${artifact}")
        endif()
    endforeach()
elseif(phase STREQUAL "after")
    if(NOT DEFINED prefix OR prefix STREQUAL "")
        message(FATAL_ERROR "Install prefix required")
    endif()
    if(IS_ABSOLUTE "${install_libdir}")
        set(destination "${install_libdir}")
    else()
        set(destination "${prefix}/${install_libdir}")
    endif()
    file(STRINGS "${parent_build}/install_manifest.txt" manifest)
    foreach(artifact IN LISTS required)
        get_filename_component(name "${artifact}" NAME)
        set(installed "${destination}/${name}")
        list(FIND manifest "${installed}" index)
        if(index EQUAL -1 OR NOT EXISTS "${installed}")
            message(FATAL_ERROR "Root install did not stage required provider artifact: ${installed}")
        endif()
        message(STATUS "Root manifest contains: ${installed}")
    endforeach()
    if(shared_count GREATER 0)
        if(target_system STREQUAL "Darwin")
            find_program(inspector otool REQUIRED)
        elseif(target_system STREQUAL "Linux")
            find_program(inspector readelf REQUIRED)
        else()
            message(FATAL_ERROR "Shared RPATH inspection requires Darwin or Linux")
        endif()
        foreach(i RANGE 1 ${shared_count})
            set(installed "${destination}/${shared_${i}_file}")
            get_filename_component(real_file "${installed}" REALPATH)
            foreach(kind soname linker)
                get_filename_component(real_name
                    "${destination}/${shared_${i}_${kind}}" REALPATH)
                if(NOT real_name STREQUAL real_file)
                    message(FATAL_ERROR "Installed ${kind} does not resolve to ${installed}")
                endif()
            endforeach()
            if(target_system STREQUAL "Darwin")
                set(inspect_flag -l)
            else()
                set(inspect_flag -d)
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C
                "${inspector}" ${inspect_flag} "${installed}"
                RESULT_VARIABLE result OUTPUT_VARIABLE dynamic ERROR_VARIABLE diagnostic)
            if(NOT result STREQUAL "0" OR NOT diagnostic STREQUAL "")
                message(FATAL_ERROR "Installed library inspection failed: ${result}: ${diagnostic}")
            endif()
            # No RPATH is legitimate, but absent/unrecognized inspection output
            # is not evidence of that. Require the native format's envelope.
            if(target_system STREQUAL "Darwin")
                if(NOT dynamic MATCHES "Load command [0-9]+\n[ \t]+cmd LC_" OR
                   NOT dynamic MATCHES "cmd LC_ID_DYLIB\n")
                    message(FATAL_ERROR "Unrecognized Mach-O load commands for ${installed}: ${dynamic}")
                endif()
            else()
                if(NOT dynamic MATCHES "Dynamic section at offset 0x[0-9a-fA-F]+ contains [0-9]+ entries:" OR
                   NOT dynamic MATCHES "Tag[ \t]+Type[ \t]+Name/Value" OR
                   NOT dynamic MATCHES "\\(NULL\\)")
                    message(FATAL_ERROR "Unrecognized ELF dynamic table for ${installed}: ${dynamic}")
                endif()
            endif()
            set(rpaths "")
            if(target_system STREQUAL "Darwin")
                string(REGEX MATCHALL "path [^\n]+ \\(offset [0-9]+\\)" entries "${dynamic}")
                foreach(entry IN LISTS entries)
                    string(REGEX REPLACE "^path (.*) \\(offset [0-9]+\\)$" "\\1" entry "${entry}")
                    list(APPEND rpaths "${entry}")
                endforeach()
            else()
                string(REGEX MATCHALL "\\((RUNPATH|RPATH)\\)[^\n]*\\[[^]\n]*\\]" entries "${dynamic}")
                foreach(entry IN LISTS entries)
                    string(REGEX REPLACE ".*\\[([^]]*)\\]" "\\1" entry "${entry}")
                    string(REPLACE ":" ";" entry "${entry}")
                    list(APPEND rpaths ${entry})
                endforeach()
            endif()
            foreach(expected IN LISTS shared_${i}_rpath)
                list(FIND rpaths "${expected}" index)
                if(index EQUAL -1)
                    message(FATAL_ERROR "Missing install RPATH ${expected}: ${installed}")
                endif()
            endforeach()
            foreach(rpath IN LISTS rpaths)
                string(FIND "${rpath}" "${parent_build}" index)
                if(NOT index EQUAL -1)
                    message(FATAL_ERROR "Build-tree RPATH retained in ${installed}: ${rpath}")
                endif()
            endforeach()
            message(STATUS "Installed loader/linker chain and RPATH checked: ${installed}: ${rpaths}")
        endforeach()
    endif()
    # The separate provider install may populate the prefix more broadly;
    # only the root manifest proves which files LibMoQ itself staged.
    foreach(artifact IN LISTS forbidden)
        get_filename_component(name "${artifact}" NAME)
        list(FIND manifest "${destination}/${name}" index)
        if(NOT index EQUAL -1)
            message(FATAL_ERROR "Root raw install unexpectedly staged: ${destination}/${name}")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "Expected phase=before or phase=after")
endif()
